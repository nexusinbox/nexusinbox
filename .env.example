# ==============================================================================
# NexusInbox — Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.
# ==============================================================================

# --- Shared / Environment ---
NODE_ENV=development

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# REQUIRED in production. In development, defaults to http://localhost:8080.
API_ORIGIN=http://localhost:8080
# Phase 4.4d (docs/25d) — Google Calendar integration. OAuth client
# ID from Google Cloud Console with scope
# `https://www.googleapis.com/auth/calendar.freebusy`. This value is
# public (it's served to browsers verbatim); the secret counterpart
# is never stored server-side because the flow is implicit-only.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# --- API Server (Rust/Axum) ---
PORT=8080
DATABASE_URL=postgres://agent_inbox:agent_inbox@localhost:5432/agent_inbox
AGENT_INBOX_DATABASE_REQUIRED=false
DATABASE_MAX_CONNECTIONS=10
AGENT_INBOX_STORAGE_BACKEND=localfs
LOG_FORMAT=

# --- Authentication ---
JWT_SECRET=replace-with-32chars-or-more-random-secret
JWT_ISSUER=nexusinbox-api
JWT_AUDIENCE=nexusinbox-web

# --- World ID ---
WORLD_ID_APP_ID=app_xxxxxxxxxxxxx
WORLD_ID_ACTION=login
# Worldcoin-issued relying-party id from Action creation in the
# Developer Portal (NOT the public hostname). See
# docs/18_production_bootstrap_2026-04-18.md for the exact shape.
WORLD_ID_RP_ID=rp_<your-rp-id>
WORLD_ID_SIGNER_PRIVATE_KEY=replace-with-world-signer-private-key-hex
AGENT_INBOX_WORLD_VERIFY_ENABLED=false
AGENT_INBOX_ALLOW_WORLD_VERIFY_MOCK=true
WORLD_ID_VERIFY_BASE_URL=https://developer.world.org

# --- Security ---
AGENT_INBOX_COOKIE_SECURE=false
# Comma-separated list of allowed CORS origins. REQUIRED in production.
# Example: AGENT_INBOX_CORS_ORIGINS=https://app.nexusinbox.ai
AGENT_INBOX_CORS_ORIGINS=

# --- Cloudflare R2 / S3-compatible attachment storage ---
AGENT_INBOX_S3_ENDPOINT=
AGENT_INBOX_S3_REGION=auto
AGENT_INBOX_S3_BUCKET=
AGENT_INBOX_S3_ACCESS_KEY_ID=
AGENT_INBOX_S3_SECRET_ACCESS_KEY=
AGENT_INBOX_S3_PATH_STYLE=true
AGENT_INBOX_S3_PREFIX=

# --- Logging (API) ---
RUST_LOG=info

# --- Example production values (do not paste blindly) ---
# NODE_ENV=production
# NEXT_PUBLIC_SITE_URL=https://app.nexusinbox.ai
# API_ORIGIN=https://api.nexusinbox.ai
# NEXT_PUBLIC_WS_URL=wss://api.nexusinbox.ai/ws
# AGENT_INBOX_DATABASE_REQUIRED=true
# AGENT_INBOX_WORLD_VERIFY_ENABLED=true
# AGENT_INBOX_COOKIE_SECURE=true
# AGENT_INBOX_CORS_ORIGINS=https://app.nexusinbox.ai
# LOG_FORMAT=json
