{
  "name": "nexusinbox",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "//": "Security floors for transitive deps flagged by `pnpm audit` / Dependabot (2026-06-12, updated 2026-09-04 and 2026-11-07). Each floor is the advisory's patched version and every range has an upper bound on the major the parents already accept, so a floor never moves a parent onto a new major (express 5 / hono / zod / ajv under @modelcontextprotocol/sdk, sharp under next). Left alone on purpose: extract-zip has no patched release (dev-only, via remotion/puppeteer in apps/promo-video) and esbuild 0.27.x (GHSA-g7r4-m6w7-qqqr is Windows dev-server only; vite 7 pins ^0.27).",
    "overrides": {
      "hono": ">=4.13.11 <5",
      "@hono/node-server": ">=2.1.3 <3",
      "fast-uri": ">=4.2.3 <5",
      "ip-address": ">=10.7.4 <11",
      "qs": ">=6.16.1 <7",
      "body-parser": ">=2.4.0 <3",
      "proxy-addr": ">=2.0.8 <3",
      "zod@4": ">=4.6.6 <5",
      "source-map-js": ">=1.2.2 <2",
      "postcss": ">=8.5.12 <9",
      "nanoid@3": ">=3.3.16 <4",
      "ws": ">=8.21.0 <9",
      "sharp": ">=0.35.5 <0.36",
      "browserslist": ">=4.28.7 <5",
      "vite@7": ">=7.3.7 <8",
      "js-yaml@4": ">=4.3.1 <5",
      "brace-expansion@1": ">=1.1.16 <2",
      "brace-expansion@2": ">=2.1.2 <3",
      "brace-expansion@5": ">=5.0.7 <6",
      "@humanfs/node": ">=0.16.8 <1"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:contract": "vitest run tests/contract/openapi-contract.test.ts",
    "lint:contract": "redocly lint openapi/openapi.yaml",
    "contract:check": "pnpm lint:contract && pnpm test:contract",
    "lint": "turbo run lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.9.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@redocly/cli": "^2.51.1",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
