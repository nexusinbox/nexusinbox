{
  "name": "nexusinbox",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:contract": "vitest run tests/contract/openapi-contract.test.ts",
    "lint:contract": "redocly lint openapi/openapi.yaml",
    "contract:check": "pnpm lint:contract && pnpm test:contract",
    "lint": "turbo run lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.9.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@redocly/cli": "^1.34.5",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "turbo": "^2.5.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
