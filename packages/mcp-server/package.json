{
  "name": "@nexusinbox/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools.js",
      "types": "./dist/tools.d.ts"
    }
  },
  "bin": {
    "nexusinbox-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "lint": "eslint src tests --ext .ts",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.4",
    "typescript": "^5.4.5",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@nexusinbox/core": "workspace:*",
    "@nexusinbox/crypto": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.0"
  }
}
