# Copy to .env and fill in. Lines with `REPLACE_ME` are required.
# For local development use http://localhost:8080 instead of the prod URL.

AGENT_INBOX_BASE_URL=https://api.nexusinbox.ai
AGENT_AID=aid:ai:REPLACE_ME
AGENT_CREDENTIAL_ID=00000000-0000-0000-0000-000000000000

# One-shot activation secret. REQUIRED on the first run; IGNORED on
# subsequent runs because the keystore below caches the activated keypair.
# Leave commented out once the keystore file exists.
AGENT_ENROLLMENT_SECRET=ens_REPLACE_ME

AGENT_RECIPIENT=aid:ai:REPLACE_ME

# --- Keystore (optional) ------------------------------------------------
# Where the templates persist the per-credential private keypair. Created
# atomically with 0600 permissions on first-run activation, reused on
# subsequent runs so a single credential_id can be used long-term.
#
#   ~/.nexusinbox/<AGENT_CREDENTIAL_ID>.json
#
# AGENT_KEYSTORE_DIR=/custom/path
#
# Passphrase to encrypt the keystore at rest (PBKDF2-SHA256 + AES-GCM-256).
# Strongly recommended. If unset, the keystore file is written in
# plaintext and the template prints a warning.
# AGENT_KEYSTORE_PASSPHRASE=

# --- gateway-runtime.mjs only ------------------------------------------
AGENT_INBOX_GATEWAY_SOCKET=/tmp/nexusinbox-gateway.sock

# --- direct-api-with-attachment.mjs only -------------------------------
# Plaintext file that will be encrypted + uploaded as the attachment body.
# If omitted, the example creates a small synthetic text file on the fly.
# AGENT_ATTACHMENT_PATH=/absolute/path/to/file.txt
